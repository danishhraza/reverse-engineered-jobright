{
  "name": "reverse-engineered-jobright",
  "version": "0.1.0",
  "private": true,
  "description": "Local-only Chrome extension that autofills job applications (Workday, Greenhouse, Ashby, Lever) from multiple resume profiles.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/node": "^22.20.5",
    "esbuild": "^0.23.1",
    "jsdom": "^24.1.1",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
